# Web DAW Backend - 환경변수 템플릿
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요.
# cp .env.example .env

# ============================================================
# 데이터베이스
# ============================================================
# 로컬 개발 (Docker Compose 사용 시)
DATABASE_URL=postgresql://webdaw_user:webdaw_password@localhost:5432/webdaw

# AWS RDS 배포 시 (EC2 환경변수로 직접 설정)
# DATABASE_URL=postgresql://user:password@your-rds-endpoint.rds.amazonaws.com:5432/webdaw

# ============================================================
# JWT 인증
# ============================================================
# 생성 방법: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# AWS S3 (오디오 파일 저장소)
# ============================================================
# IAM 사용자 자격증명 (루트 계정 절대 사용 금지)
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_REGION=ap-northeast-2

# S3 버킷 이름 (전 세계에서 유일해야 함)
S3_BUCKET_NAME=web-daw-audio-files-yourname

# ============================================================
# 앱 설정
# ============================================================
# development | production
ENVIRONMENT=development
